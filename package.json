{
  "name": "cc-coursemap",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "^22.0.0 || ^24.0.0"
  },
  "scripts": {
    "build:css": "tailwindcss -i ./app/tailwind.source.css -o ./app/globals.css --minify",
    "dev:css": "tailwindcss -i ./app/tailwind.source.css -o ./app/globals.css --watch",
    "dev:next": "next dev",
    "dev": "npm run build:css && concurrently --names \"css,next\" --prefix-colors \"cyan,green\" --kill-others-on-fail \"npm:dev:css\" \"npm:dev:next\"",
    "build": "npm run build:css && npm run build:transfer-universities-cache && npm run build:transfer-coverage-rollup && npm run build:transfer-dest-rollup && npm run build:term-counts-snapshot && next build",
    "build:term-counts-snapshot": "tsx scripts/build-term-counts-snapshot.ts",
    "build:transfer-universities-cache": "tsx scripts/build-transfer-universities-cache.ts",
    "build:transfer-coverage-rollup": "tsx scripts/build-transfer-coverage-rollup.ts",
    "build:transfer-dest-rollup": "tsx scripts/build-transfer-dest-rollup.ts",
    "build:state-summaries": "tsx scripts/build-state-summaries.ts",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "check:registry": "tsx scripts/check-registry-integrity.ts",
    "check:scrapers": "tsx scripts/check-scraper-coverage.ts",
    "check:config-data": "tsx scripts/check-config-data-consistency.ts",
    "check:scraper-terms": "tsx scripts/check-scraper-term-hardcoding.ts",
    "check:data": "tsx scripts/check-data-integrity.ts",
    "check:blog-mdx": "tsx scripts/check-blog-mdx.ts",
    "check:scorecard": "tsx scripts/check-scorecard-freshness.ts",
    "eval:search": "tsx scripts/eval-search-intent.ts",
    "scrape": "tsx scripts/scrape-vccs.ts",
    "scrape:college": "tsx scripts/scrape-vccs.ts --college",
    "discover:ps": "tsx scripts/discover-ps-responses.ts",
    "enrich": "tsx scripts/enrich-peoplesoft.ts",
    "enrich:college": "tsx scripts/enrich-peoplesoft.ts --slug",
    "enrich:dry-run": "tsx scripts/enrich-peoplesoft.ts --dry-run",
    "scrape:transfer": "tsx scripts/scrape-transfer-equiv.ts",
    "scrape:transfer:vcu": "tsx scripts/scrape-transfer-vcu.ts",
    "scrape:transfer:odu": "tsx scripts/scrape-transfer-odu.ts",
    "scrape:transfer:gmu": "tsx scripts/scrape-transfer-gmu.ts",
    "scrape:transfer:umw": "tsx scripts/scrape-transfer-umw.ts",
    "scrape:ps": "tsx scripts/scrape-peoplesoft.ts",
    "scrape:ps:summer": "tsx scripts/scrape-peoplesoft.ts --term \"Summer 2026\"",
    "scrape:ps:fall": "tsx scripts/scrape-peoplesoft.ts --term \"Fall 2026\"",
    "scrape:transfer:vsu": "tsx scripts/scrape-transfer-vsu.ts",
    "scrape:transfer:vwu": "tsx scripts/scrape-transfer-vwu.ts",
    "scrape:transfer:uva": "tsx scripts/scrape-transfer-uva.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.93.0",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.2.2",
    "@supabase/ssr": "^0.10.2",
    "@supabase/supabase-js": "^2.101.1",
    "@types/d3-geo": "^3.1.0",
    "@types/mdx": "^2.0.13",
    "@types/topojson-client": "^3.1.5",
    "@vercel/analytics": "^2.0.1",
    "d3-geo": "^3.1.1",
    "leaflet": "^1.9.4",
    "next": "16.2.1",
    "next-themes": "^0.4.6",
    "pdf-parse": "^2.4.5",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-leaflet": "^5.0.0",
    "resend": "^6.10.0",
    "topojson-client": "^3.1.0",
    "us-atlas": "^3.0.1",
    "xlsx": "^0.18.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.0",
    "@tailwindcss/typography": "^0.5.19",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cheerio": "^1.2.0",
    "concurrently": "^9.2.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.1",
    "playwright": "^1.58.2",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^4.1.5"
  },
  "browserslist": [
    "chrome >= 90",
    "edge >= 90",
    "firefox >= 90",
    "safari >= 14",
    "ios_saf >= 14"
  ]
}
